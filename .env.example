# Скопируйте в .env и подставьте свои значения. Сам .env в Git не попадает.
DEBUG=True
SECRET_KEY=придумайте-длинную-случайную-строку
# PostgreSQL. Если DB_NAME не указан — проект работает с SQLite (backend/db.sqlite3)
DB_NAME=marketplace
DB_USER=marketplace
DB_PASSWORD=marketplace
DB_HOST=localhost
DB_PORT=5432
